generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vocabProgress      UserVocabProgress[]
  drillAttempts      DrillAttempt[]
  verbProgress       UserVerbProgress[]
  verbAttempts       VerbAttempt[]
  pronounTenseScores UserPronounTenseScore[]
  masteredNetLog     MasteredNetLog[]
}

model Verb {
  id          String   @id @default(cuid())
  infinitive  String   @unique
  english     String
  isRegular   Boolean  @default(true)
  sortOrder   Int      @unique

  conjugations VerbConjugation[]
}

model VerbConjugation {
  id         String  @id @default(cuid())
  verbId     String
  tense      String
  pronoun    String
  form       String
  exampleEs  String? // example sentence in Spanish
  exampleEn  String? // example sentence in English

  verb     Verb               @relation(fields: [verbId], references: [id])
  progress UserVerbProgress[]
  attempts VerbAttempt[]

  @@unique([verbId, tense, pronoun])
}

model UserVerbProgress {
  id            String    @id @default(cuid())
  userId        String
  conjugationId String
  bucket        String    @default("unseen")
  score         Int       @default(0)
  lastSeenAt    DateTime?
  masteredAt    DateTime?
  updatedAt     DateTime  @updatedAt

  user        User            @relation(fields: [userId], references: [id])
  conjugation VerbConjugation @relation(fields: [conjugationId], references: [id])

  @@unique([userId, conjugationId])
}

model VerbAttempt {
  id            String   @id @default(cuid())
  userId        String
  conjugationId String
  correct       Boolean
  createdAt     DateTime @default(now())

  user        User            @relation(fields: [userId], references: [id])
  conjugation VerbConjugation @relation(fields: [conjugationId], references: [id])
}

model DictionaryEntry {
  id                  String  @id @default(cuid())
  sortOrder           Int     @unique
  englishPrimary      String?
  englishVariantsJson Json?
  spanish             String
  spanishDisplay      String?
  emoji               String?
  category            String  @default("vocabulary")

  vocabProgress  UserVocabProgress[]
  drillAttempts  DrillAttempt[]
  masteredNetLog MasteredNetLog[]
}

// Tracks which bucket a user has placed a given word in.
// bucket: unseen | learning | learned | mastered
model UserVocabProgress {
  id         String    @id @default(cuid())
  userId     String
  entryId    String
  bucket     String    @default("unseen")
  score      Int       @default(0)
  lastSeenAt DateTime?
  masteredAt DateTime?
  updatedAt  DateTime  @updatedAt

  user  User            @relation(fields: [userId], references: [id])
  entry DictionaryEntry @relation(fields: [entryId], references: [id])

  @@unique([userId, entryId])
}

// Net mastered event log: +1 when promoted to mastered, -1 when demoted from mastered.
// Used to compute net mastered-per-day for the bar chart.
model MasteredNetLog {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  delta     Int      // +1 or -1
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id])
  entry DictionaryEntry @relation(fields: [entryId], references: [id])
}

// Aggregated score per user × pronoun × tense for the heatmap.
model UserPronounTenseScore {
  id        String   @id @default(cuid())
  userId    String
  pronoun   String
  tense     String
  score     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, pronoun, tense])
}

// One row per drill attempt (correct or incorrect).
model DrillAttempt {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  correct   Boolean
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id])
  entry DictionaryEntry @relation(fields: [entryId], references: [id])
}
