generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String?  @unique
  isAdmin   Boolean  @default(false)
  role      String   @default("learner") // learner | teacher
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vocabProgress        UserVocabProgress[]
  drillAttempts        DrillAttempt[]
  verbProgress         UserVerbProgress[]
  verbAttempts         VerbAttempt[]
  pronounTenseScores   UserPronounTenseScore[]
  masteredNetLog       MasteredNetLog[]
  taughtClassrooms     Classroom[]           @relation("TeacherClassrooms")
  enrolledClassrooms   ClassroomStudent[]
  phraseProgress       UserPhraseProgress[]
  phraseAttempts       PhraseAttempt[]
  phraseMasteredNetLog PhraseMasteredNetLog[]
}

model Verb {
  id          String   @id @default(cuid())
  infinitive  String   @unique
  english     String
  isRegular   Boolean  @default(true)
  sortOrder   Int      @unique

  conjugations VerbConjugation[]
}

model VerbConjugation {
  id         String  @id @default(cuid())
  verbId     String
  tense      String
  pronoun    String
  form       String
  exampleEs  String? // example sentence in Spanish
  exampleEn  String? // example sentence in English

  verb     Verb               @relation(fields: [verbId], references: [id])
  progress UserVerbProgress[]
  attempts VerbAttempt[]

  @@unique([verbId, tense, pronoun])
}

model UserVerbProgress {
  id            String    @id @default(cuid())
  userId        String
  conjugationId String
  bucket        String    @default("unseen")
  score         Int       @default(0)
  lastSeenAt    DateTime?
  masteredAt    DateTime?
  updatedAt     DateTime  @updatedAt

  user        User            @relation(fields: [userId], references: [id])
  conjugation VerbConjugation @relation(fields: [conjugationId], references: [id])

  @@unique([userId, conjugationId])
}

model VerbAttempt {
  id            String   @id @default(cuid())
  userId        String
  conjugationId String
  correct       Boolean
  createdAt     DateTime @default(now())

  user        User            @relation(fields: [userId], references: [id])
  conjugation VerbConjugation @relation(fields: [conjugationId], references: [id])
}

model DictionaryEntry {
  id                  String  @id @default(cuid())
  sortOrder           Int     @unique
  englishPrimary      String?
  englishVariantsJson Json?
  spanish             String
  spanishDisplay      String?
  emoji               String?
  category            String  @default("vocabulary")
  exampleEs           String?
  exampleEn           String?
  imageUrl            String?

  vocabProgress  UserVocabProgress[]
  drillAttempts  DrillAttempt[]
  masteredNetLog MasteredNetLog[]
}

// Tracks which bucket a user has placed a given word in.
// bucket: unseen | learning | learned | mastered
model UserVocabProgress {
  id         String    @id @default(cuid())
  userId     String
  entryId    String
  bucket     String    @default("unseen")
  score      Int       @default(0)
  lastSeenAt DateTime?
  masteredAt DateTime?
  updatedAt  DateTime  @updatedAt

  user  User            @relation(fields: [userId], references: [id])
  entry DictionaryEntry @relation(fields: [entryId], references: [id])

  @@unique([userId, entryId])
}

model Classroom {
  id        String   @id @default(cuid())
  name      String
  teacherId String
  createdAt DateTime @default(now())

  teacher  User               @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  students ClassroomStudent[]
}

model ClassroomStudent {
  id          String   @id @default(cuid())
  classroomId String
  userId      String
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([classroomId, userId])
}

// Net mastered event log: +1 when promoted to mastered, -1 when demoted from mastered.
// Used to compute net mastered-per-day for the bar chart.
model MasteredNetLog {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  delta     Int      // +1 or -1
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id])
  entry DictionaryEntry @relation(fields: [entryId], references: [id])
}

// Aggregated score per user × pronoun × tense for the heatmap.
model UserPronounTenseScore {
  id        String   @id @default(cuid())
  userId    String
  pronoun   String
  tense     String
  score     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, pronoun, tense])
}

model Phrase {
  id                 String   @id @default(cuid())
  sortOrder          Int      @unique
  spanish            String
  english            String
  englishVariantsJson Json?
  grammarTag         String   @default("general")
  difficultyLevel    Int      @default(1)
  grammarNote        String?

  progress UserPhraseProgress[]
  attempts PhraseAttempt[]
  phraseMasteredNetLog PhraseMasteredNetLog[]
}

model UserPhraseProgress {
  id         String    @id @default(cuid())
  userId     String
  phraseId   String
  bucket     String    @default("unseen")
  score      Int       @default(0)
  lastSeenAt DateTime?
  masteredAt DateTime?
  updatedAt  DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  phrase Phrase @relation(fields: [phraseId], references: [id])

  @@unique([userId, phraseId])
}

model PhraseAttempt {
  id        String   @id @default(cuid())
  userId    String
  phraseId  String
  correct   Boolean
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  phrase Phrase @relation(fields: [phraseId], references: [id])
}

model PhraseMasteredNetLog {
  id        String   @id @default(cuid())
  userId    String
  phraseId  String
  delta     Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  phrase Phrase @relation(fields: [phraseId], references: [id])
}

// One row per drill attempt (correct or incorrect).
model DrillAttempt {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  correct   Boolean
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id])
  entry DictionaryEntry @relation(fields: [entryId], references: [id])
}
